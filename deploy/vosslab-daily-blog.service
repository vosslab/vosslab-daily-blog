[Unit]
Description=Vosslab Daily Blog (LAN and Tailscale port 8016)
Documentation=http://aella.local:8016
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vosslab/nsh/vosslab-daily-blog
ExecStart=/usr/bin/python3 -m http.server 8016 --bind 0.0.0.0 --directory /home/vosslab/nsh/vosslab-daily-blog/site
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
